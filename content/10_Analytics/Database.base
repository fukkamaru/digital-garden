views:
  - type: table
    name: 表
    order:
      - file.name
      - title
      - file.folder
      - type
      - file.tags
      - file.ctime
      - file.mtime
      - file.links
      - draft
    sort:
      - property: draft
        direction: DESC
      - property: file.folder
        direction: ASC
      - property: file.ctime
        direction: DESC
      - property: file.mtime
        direction: DESC
      - property: file.tags
        direction: DESC
      - property: type
        direction: DESC
    columnSize:
      file.name: 253
      note.title: 178
      file.folder: 132
      note.type: 148
      file.tags: 178
      file.ctime: 173
      file.links: 93
  - type: table
    name: ビュー
