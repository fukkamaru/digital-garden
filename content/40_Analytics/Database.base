views:
  - type: table
    name: 表
    order:
      - file.name
      - title
      - file.folder
      - type
      - file.tags
      - file.ctime
      - file.mtime
      - file.links
    sort:
      - property: file.tags
        direction: DESC
      - property: file.folder
        direction: DESC
      - property: type
        direction: ASC
    columnSize:
      file.name: 253
      file.folder: 132
      note.type: 148
      file.ctime: 173
      file.links: 223
  - type: table
    name: ビュー
